# =================================================================
#  Fleet Rentals Nigeria - Essential Environment & API Configuration
# =================================================================

# 1. Google Maps Platform API Key
# Required for:
#   - Flutter Web: web/index.html (Maps JavaScript API)
#   - Android: android/app/src/main/AndroidManifest.xml
#   - iOS: ios/Runner/AppDelegate.swift
# Enable these APIs in Google Cloud Console:
#   - Maps JavaScript API
#   - Maps SDK for Android
#   - Maps SDK for iOS
#   - Geocoding API / Places API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# 2. Fleet Rentals Backend API Base URL
# The REST API endpoint used by lib/utils/config.dart.
# Default development server: https://carlink.cscodetech.cloud/api/
# In production, point this to your own backend domain or Vercel proxy.
BASE_URL=https://carlink.cscodetech.cloud/api/
IMG_URL=https://carlink.cscodetech.cloud/

# 3. Paystack Payment Gateway (Nigeria - Live / Test)
# Required for live Nigerian Card payments, Bank Transfers, and USSD.
# Obtain from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# 4. Alternative Gateways (Optional)
# Flutterwave (obtain from https://dashboard.flutterwave.com)
FLUTTERWAVE_PUBLIC_KEY=YOUR_FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_ENCRYPTION_KEY=YOUR_FLUTTERWAVE_ENCRYPTION_KEY

# Stripe (International Card Processing - Optional)
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# 5. Vercel CI/CD Deployment Tokens (Optional - for GitHub Actions)
# Used in .github/workflows/deploy-vercel.yml
VERCEL_TOKEN=your_vercel_personal_access_token_here
VERCEL_ORG_ID=your_vercel_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
